{
  "$comment": "复制为 config.json 后按需修改。config.json 已被 .gitignore 排除。",

  "listen": "127.0.0.1:8443",
  "certFile": "./certs/localhost.crt",
  "keyFile": "./certs/localhost.key",
  "manifestDir": "./data/manifests",
  "stateFile": "./data/state.json",

  "$comment_rewriteHosts": "只有 host 命中此列表的 InstallerUrl 才会被改写，其余原样透传",
  "rewriteHosts": [
    "github.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "release-assets.githubusercontent.com"
  ],

  "$comment_accelerators": "按 priority 升序选择第一个健康的；{url} 替换为原始完整 URL",
  "accelerators": [
    {
      "name": "gh-proxy",
      "template": "https://gh-proxy.com/{url}",
      "priority": 1
    },
    {
      "name": "ghfast",
      "template": "https://ghfast.top/{url}",
      "priority": 2
    }
  ],

  "health": {
    "enabled": true,
    "intervalSeconds": 300,
    "timeoutSeconds": 8,
    "failuresBeforeUnhealthy": 2,
    "probeUrl": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-pc-windows-msvc.zip"
  },

  "$comment_fallback": "所有加速器都不健康时，是否回退到原始 URL（慢但可用）",
  "fallbackToOriginal": true,

  "logLevel": "info"
}
